--!strict
-- Rule table. `store = true` marks a practice that the Creator Store asset rules
-- forbid in distributed models and plugins (remote require, loadstring,
-- getfenv/setfenv, LoadAsset, LinkedSource, obfuscation, extremely large scripts).

export type Severity = "critical" | "high" | "medium" | "low"

export type Rule = {
	id: string,
	severity: Severity,
	store: boolean,
	title: string,
	why: string,
	fix: string,
}

local list: { Rule } = {
	{ id = "remote-require", severity = "critical", store = true,
		title = "Loads code by asset ID (require with a number)",
		why = "require(assetId) downloads a module that the author can change at any time. Most backdoors use it.",
		fix = "Delete the script unless you wrote it. If you need the module, copy it into your game." },
	{ id = "remote-require-hidden", severity = "critical", store = true,
		title = "Loads code by asset ID through a variable or string",
		why = "The asset ID is kept in a variable, a string or a computed number, so it is harder to see.",
		fix = "Delete the script unless you wrote it." },
	{ id = "loadstring", severity = "critical", store = true,
		title = "Runs code from a string (loadstring)",
		why = "loadstring runs any text as code. Backdoors use it to run commands sent from outside.",
		fix = "Delete the script. Turn off LoadStringEnabled in ServerScriptService." },
	{ id = "obfuscator-signature", severity = "critical", store = true,
		title = "Code from a known obfuscator",
		why = "The source contains the marker of a known Lua obfuscator. You cannot see what it does.",
		fix = "Delete the script unless you trust the author and have the readable source." },
	{ id = "fenv", severity = "high", store = true,
		title = "Changes the script environment (getfenv or setfenv)",
		why = "getfenv and setfenv can hide which functions are called. The Creator Store forbids them.",
		fix = "Remove the call, or delete the script if you did not write it." },
	{ id = "load-asset", severity = "high", store = true,
		title = "Inserts assets at run time (LoadAsset, GetObjects)",
		why = "The script pulls a model from the website while the game runs. That model can contain more scripts.",
		fix = "Insert the model in Studio and save it in your game instead." },
	{ id = "linked-source", severity = "high", store = true,
		title = "Uses LinkedSource",
		why = "LinkedSource loads the script body from another asset. The Creator Store forbids it.",
		fix = "Paste the code into the script and clear LinkedSource." },
	{ id = "hidden-name", severity = "high", store = true,
		title = "Builds a dangerous name from pieces",
		why = "A name such as require or loadstring is joined from parts, reversed or encoded so that a search does not find it.",
		fix = "Delete the script unless you wrote it." },
	{ id = "escape-obfuscation", severity = "high", store = true,
		title = "String written as escape codes",
		why = "A long string is written as \\ddd or \\x codes. This is a common way to hide code.",
		fix = "Decode the string and read it, or delete the script." },
	{ id = "hidden-code", severity = "high", store = true,
		title = "Code pushed off screen with spaces",
		why = "A line has hundreds of spaces before more code, so the code is outside the editor view.",
		fix = "Scroll right on that line and read it. Delete the script if you did not write it." },
	{ id = "webhook", severity = "high", store = false,
		title = "Sends data to a Discord webhook",
		why = "A free model has no reason to post from your game to a chat server. This is a common data leak.",
		fix = "Delete the webhook call or the script." },
	{ id = "virus-name", severity = "high", store = false,
		title = "Script name used by known viruses",
		why = "Names such as Vaccine, Infected or Spread come from old self-copying viruses.",
		fix = "Read the script. Delete it if it copies itself or does not belong to the model." },
	{ id = "string-char", severity = "medium", store = true,
		title = "Text built with string.char",
		why = "Many numbers are turned into text at run time. This can hide code.",
		fix = "Read what the numbers decode to (shown in the detail)." },
	{ id = "long-string", severity = "medium", store = true,
		title = "Very long encoded string",
		why = "A string of thousands of base64 or hex characters is often packed code.",
		fix = "Check what reads the string. Delete it if it is decoded and run." },
	{ id = "long-line", severity = "medium", store = true,
		title = "Extremely long line",
		why = "Lines with thousands of characters are often packed code. The Creator Store restricts very large scripts.",
		fix = "Format the code or remove the line." },
	{ id = "purchase-prompt", severity = "medium", store = false,
		title = "Prompts players to buy something",
		why = "A free model that prompts purchases can sell someone else's items in your game.",
		fix = "Check the asset or game pass ID. Remove the prompt if it is not yours." },
	{ id = "teleport", severity = "medium", store = false,
		title = "Teleports players to a fixed place",
		why = "A free model that teleports players to a hard-coded place can steal your players.",
		fix = "Check the place ID. Remove the teleport if it is not your place." },
	{ id = "self-hide", severity = "medium", store = false,
		title = "Script hides or renames itself",
		why = "Setting script.Parent to nil or changing script.Name at run time is a way to avoid being found.",
		fix = "Read the script to see why it hides." },
	{ id = "hardcoded-user", severity = "medium", store = false,
		title = "Special handling for a fixed user ID",
		why = "Code that checks for one UserId can give a stranger admin rights in your game.",
		fix = "Check whose ID it is. Remove the check if it is not you or your team." },
	{ id = "odd-parent", severity = "medium", store = false,
		title = "Script inside an object that does not run scripts",
		why = "Scripts placed in welds, decals, sounds or attachments are often hidden on purpose.",
		fix = "Move the script to a normal place or delete it." },
	{ id = "duplicate-script", severity = "medium", store = false,
		title = "Same script copied many times",
		why = "Self-copying viruses leave many identical scripts across the game.",
		fix = "Read one copy. If it is a virus, delete all copies." },
	{ id = "http", severity = "low", store = false,
		title = "Makes web requests",
		why = "The script calls HttpService. This is normal in some systems, but not in most free models.",
		fix = "Check the URL. Turn off Allow HTTP Requests if you do not need it." },
	{ id = "large-script", severity = "low", store = true,
		title = "Very large script",
		why = "The Creator Store restricts unnecessarily large scripts.",
		fix = "Split the script or remove unused data." },
}

local byId: { [string]: Rule } = {}
for _, r in list do
	byId[r.id] = r
end

local rank: { [string]: number } = { critical = 4, high = 3, medium = 2, low = 1 }

return {
	list = list,
	byId = byId,
	rank = rank,
	-- Names that are dangerous when they appear in built or encoded strings.
	dangerousNames = {
		"require", "loadstring", "getfenv", "setfenv", "LoadAsset", "GetObjects",
		"HttpGet", "LinkedSource", "InsertService", "RequestAsync", "PostAsync",
	},
	-- Checked in comments and code only, never inside string literals.
	obfuscatorMarkers = {
		"Luraph Obfuscator", "LPH_ENCSTR", "LPH_JIT", "LPH_NO_VIRTUALIZE", "IronBrew", "Iron Brew",
		"MoonSec", "PSU|", "Prometheus Obfuscator", "FiOne", "Rerubi", "LuaVM",
	},
	virusNames = {
		"vaccine", "infect", "virus", "spread", "worm", "4d being",
		"dont delete", "don't delete", "do not delete", "anti lag", "antilag", "anti-lag",
	},
	oddParents = {
		Weld = true, WeldConstraint = true, Motor6D = true, Decal = true, Texture = true,
		Sound = true, Attachment = true, ParticleEmitter = true, PointLight = true,
		SpotLight = true, SurfaceLight = true, SpecialMesh = true, Smoke = true,
		Fire = true, Sparkles = true, BlockMesh = true, CylinderMesh = true,
		SurfaceAppearance = true, Beam = true, Trail = true,
	},
}
